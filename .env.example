# Hardened fork: nothing here points at T3's services. With no `.env`, T3 Connect,
# Clerk sign-in and relay tracing stay off, which is the intended default.
# Do not add server-side secrets to this file.

# Self-hosted relay (e.g. on saserver). T3 Connect only turns on when this names a
# relay that is not one of T3's hosts; see docs/fork/HARDENING.md.
# T3CODE_RELAY_URL=https://relay.example.internal

# Your own Clerk instance, only if your self-hosted relay uses Clerk.
# T3CODE_CLERK_PUBLISHABLE_KEY=
# T3CODE_CLERK_JWT_TEMPLATE=
# T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=

# A self-hosted copy of the web app for hosted pairing links (VITE_HOSTED_APP_URL at
# web build time). Without it, pairing links point straight at your server.
# T3CODE_HOSTED_APP_URL=
